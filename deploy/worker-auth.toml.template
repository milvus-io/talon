# Static per-bucket credentials for one S3 worker.
# Replace names/credentials and keep only the buckets this worker should serve.
# All buckets share the backend family; connection settings may inherit defaults.
# Credentials belong to each bucket. Do not also set top-level credential fields.
# TALON_WORKER_BUCKETS (JSON) replaces the entire list when supplied.

cluster_id = "default"
coordinator = "127.0.0.1:7000"
listen = "127.0.0.1:7001"
admin_listen = "127.0.0.1:8001"
cache_dirs = ["./talon-cache"]

backend = "s3"
s3_region = "us-west-2"
s3_path_style = false

[[buckets]]
name = "bucket-a"
credentials_source = "aksk"
s3_access_key_id = "<AK_A>"
s3_secret_access_key = "<SK_A>"
# s3_session_token = "<SESSION_TOKEN_A>"  # only for temporary keys

[[buckets]]
name = "bucket-b"
credentials_source = "iam"
# Uses the process's AWS default identity chain, including the EC2 instance role.
# Multiple IAM entries use that same platform identity, not separate assumed roles.

[[buckets]]
name = "bucket-c"
credentials_source = "broker"
# Object storage endpoint used for origin reads/writes; separate from the Broker API URL.
# Optional for AWS (defaults from s3_region); required for OSS/COS/OBS.
s3_endpoint = "https://s3.us-west-2.amazonaws.com"
# Optional per-attempt credential fetch timeout; omitted defaults to 3000 ms.
# Does not change storage I/O timeouts. Valid in each bucket or at top level for
# a worker without [[buckets]]. Top-level env override: TALON_CREDENTIAL_BROKER_TIMEOUT_MS.
credential_broker_timeout_ms = 3000
credential_broker_url = "http://<broker-host>:8080/v1/credentials/assume-role"
credential_broker_request.csp = "aws"
credential_broker_request.region = "us-west-2"
credential_broker_request.bucket = "bucket-c"
credential_broker_request.roleArn = "arn:aws:iam::<account-id>:role/<role-name>"
credential_broker_request.externalId = "<external-id>"
credential_broker_request.durationSeconds = 3600
