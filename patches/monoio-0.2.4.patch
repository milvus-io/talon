+#[cfg(target_os = "linux")]
+impl TcpStream {
+    /// Receive directly into an owned buffer, returning the kTLS record type
+    /// and message flags. Ancillary storage and the FD survive cancellation.
+    pub async fn recv_tls<T: IoBufMut>(&mut self, buf: T, flags: i32) -> BufResult<(usize, u8, i32), T> {
+        Op::recv_tls(self.fd.clone(), buf, flags).unwrap().wait_tls().await
+    }
+    /// Send a TLS control record using owned payload and ancillary storage.
+    pub async fn send_tls<T: IoBuf>(&mut self, buf: T, kind: u8) -> BufResult<usize, T> {
+        Op::send_tls(self.fd.clone(), buf, kind).unwrap().wait_tls_send().await
+    }
